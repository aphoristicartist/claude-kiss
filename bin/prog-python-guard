#!/usr/bin/env python3
"""Block Bash calls outside the prog + Python experiment contract."""

import json
import shlex
import sys

ALLOWED_EXECUTABLES = {"prog", "python3"}
SHELL_PUNCTUATION = frozenset("();<>|&")


def deny(reason: str) -> None:
    json.dump(
        {
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": reason,
            }
        },
        sys.stdout,
        separators=(",", ":"),
    )
    sys.stdout.write("\n")


def has_unquoted_line_break(command: str) -> bool:
    """Return whether a line break can be interpreted by the shell."""
    quote = None
    escaped = False

    for character in command:
        if character in "\r\n" and quote is None:
            return True
        if escaped:
            escaped = False
            continue
        if quote == "'":
            if character == "'":
                quote = None
            continue
        if character == "\\":
            escaped = True
            continue
        if quote == '"':
            if character == '"':
                quote = None
            continue
        if character in {"'", '"'}:
            quote = character

    return False


def main() -> int:
    try:
        payload = json.load(sys.stdin)
        command = payload["tool_input"]["command"]
    except (KeyError, TypeError, ValueError, json.JSONDecodeError):
        deny("prog-python blocked a malformed Bash tool request")
        return 0

    if not isinstance(command, str) or not command.strip():
        deny("prog-python requires a non-empty prog or python3 invocation")
        return 0

    if has_unquoted_line_break(command):
        deny(
            "prog-python blocks line breaks outside quoted arguments; "
            "put multiline source inside the quoted python3 -c argument"
        )
        return 0
    if "$(" in command or "`" in command:
        deny("prog-python blocks shell command substitution")
        return 0

    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
        lexer.whitespace_split = True
        tokens = list(lexer)
    except ValueError:
        deny("prog-python could not parse the Bash command conservatively")
        return 0

    if not tokens or tokens[0] not in ALLOWED_EXECUTABLES:
        deny("prog-python allows Bash calls beginning only with prog or python3")
        return 0
    if any(token and set(token) <= SHELL_PUNCTUATION for token in tokens[1:]):
        deny("prog-python blocks shell composition; compose in Python or use prog exact argv")
        return 0

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
