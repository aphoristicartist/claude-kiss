#!/bin/sh
set -eu

core_tools="Bash,Glob,Grep,Read,Edit,Write"
state_home=${XDG_STATE_HOME:-$HOME/.local/state}
profiles_dir=${CLAUDE_KISS_PROFILES_DIR:-$state_home/claude-kiss/profiles}

usage() {
  cat <<'EOF'
claude-kiss-profile — named Claude KISS tool profiles

The six core coding tools are always enabled:
Bash, Glob, Grep, Read, Edit, Write

Usage:
  claude-kiss-profile create NAME [FEATURE...]
                                     Create a profile; prompts when no features are given
  claude-kiss-profile launch NAME [Claude arguments...]
                                     Launch a profile
  claude-kiss-profile NAME [Claude arguments...]
                                     Short form for launch
  claude-kiss-profile list           List profiles
  claude-kiss-profile show NAME      Show a profile's features and tools
  claude-kiss-profile rm NAME        Remove a profile
  claude-kiss-profile -h | --help    Show this help

Features:
  lsp                LSP code intelligence
  agent              Agent subagents and TaskStop
  tasks              TaskCreate, TaskGet, TaskList, TaskUpdate, TaskStop
  skill              User-controlled Skill invocations
  web-fetch          WebFetch
  web-search         WebSearch
  worktree           EnterWorktree and ExitWorktree
  mcp-resources      ListMcpResourcesTool and ReadMcpResourceTool
  tool-search        ToolSearch for explicit large MCP configurations
  none               No optional tools; keep only the six core tools

Profiles select built-in tools only. MCP servers still require an explicit
--mcp-config argument passed through to Claude Code.
EOF
}

fail() {
  printf 'claude-kiss-profile: %s\n' "$1" >&2
  if [ "${2-}" ]; then
    printf 'claude-kiss-profile: %s\n' "$2" >&2
  fi
  exit 1
}

valid_name() {
  case "$1" in
    ''|.*|-*|*[!A-Za-z0-9._-]*|create|launch|list|show|rm|help)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

canonical_feature() {
  case "$1" in
    lsp|lsp-code-intelligence) printf 'lsp\n' ;;
    agent|agents|subagent|subagents) printf 'agent\n' ;;
    task|tasks|task-tools|task-tracking) printf 'tasks\n' ;;
    skill|skills) printf 'skill\n' ;;
    web-fetch|webfetch) printf 'web-fetch\n' ;;
    web-search|websearch) printf 'web-search\n' ;;
    worktree|worktrees) printf 'worktree\n' ;;
    mcp|mcp-resource|mcp-resources) printf 'mcp-resources\n' ;;
    tool-search|toolsearch) printf 'tool-search\n' ;;
    none|bare) printf 'none\n' ;;
    *) return 1 ;;
  esac
}

add_feature() {
  case ",$selected_features," in
    *",$1,"*) ;;
    *) selected_features="${selected_features:+$selected_features,}$1" ;;
  esac
}

normalize_features() {
  selected_features=""
  for requested in "$@"; do
    feature=$(canonical_feature "$requested") ||
      fail "unknown feature: $requested" "Run claude-kiss-profile --help for valid features."
    if [ "$feature" = none ]; then
      selected_features=""
    fi
    add_feature "$feature"
  done
}

ask_feature() {
  label=$1
  feature=$2
  printf 'Enable %s? [y/N] ' "$label" >&2
  IFS= read -r answer || return 0
  case "$answer" in
    y|Y|yes|Yes|YES|1) add_feature "$feature" ;;
  esac
}

interactive_features() {
  selected_features=""
  ask_feature 'LSP code intelligence' lsp
  ask_feature 'Agent subagents and TaskStop' agent
  ask_feature 'task tracking tools' tasks
  ask_feature 'user-controlled Skill invocations' skill
  ask_feature 'WebFetch' web-fetch
  ask_feature 'WebSearch' web-search
  ask_feature 'worktree entry and exit' worktree
  ask_feature 'MCP resource tools' mcp-resources
  ask_feature 'ToolSearch for large explicit MCP configs' tool-search
  [ -n "$selected_features" ] || selected_features=none
}

validate_features() {
  for stored_feature in $(printf '%s\n' "$1" | tr ',' ' '); do
    canonical_feature "$stored_feature" >/dev/null ||
      fail "invalid feature in profile: $stored_feature"
  done
}

append_tool() {
  case ",$profile_tools," in
    *",$1,"*) ;;
    *) profile_tools="$profile_tools,$1" ;;
  esac
}

tools_for_features() {
  profile_tools=$core_tools
  for feature in $(printf '%s\n' "$1" | tr ',' ' '); do
    case "$feature" in
      lsp) append_tool LSP ;;
      agent)
        append_tool Agent
        append_tool TaskStop
        ;;
      tasks)
        append_tool TaskCreate
        append_tool TaskGet
        append_tool TaskList
        append_tool TaskUpdate
        append_tool TaskStop
        ;;
      skill) append_tool Skill ;;
      web-fetch) append_tool WebFetch ;;
      web-search) append_tool WebSearch ;;
      worktree)
        append_tool EnterWorktree
        append_tool ExitWorktree
        ;;
      mcp-resources)
        append_tool ListMcpResourcesTool
        append_tool ReadMcpResourceTool
        ;;
      tool-search) append_tool ToolSearch ;;
    esac
  done
}

profile_path() {
  valid_name "$1" ||
    fail 'invalid profile name' 'Use letters, numbers, dots, underscores, or hyphens; no leading dots.'
  printf '%s\n' "$profiles_dir/$1.profile"
}

create_profile() {
  name=$1
  shift
  path=$(profile_path "$name")
  if [ "$#" -eq 0 ]; then
    interactive_features
  else
    normalize_features "$@"
  fi
  mkdir -p "$profiles_dir"
  temporary=$(mktemp "$profiles_dir/.${name}.XXXXXX")
  printf '%s\n' "$selected_features" >"$temporary"
  mv "$temporary" "$path"
  tools_for_features "$selected_features"
  printf 'Created profile %s\nFeatures: %s\nTools: %s\n' \
    "$name" "${selected_features:-none}" "$profile_tools" >&2
}

show_profile() {
  path=$(profile_path "$1")
  [ -f "$path" ] || fail "profile not found: $1"
  features=$(cat "$path")
  validate_features "$features"
  tools_for_features "$features"
  printf 'Profile: %s\nFeatures: %s\nTools: %s\n' \
    "$1" "${features:-none}" "$profile_tools"
}

remove_profile() {
  path=$(profile_path "$1")
  [ -f "$path" ] || fail "profile not found: $1"
  rm -- "$path"
  printf 'Removed profile %s\n' "$1"
}

launch_profile() {
  name=$1
  shift
  path=$(profile_path "$name")
  [ -f "$path" ] || fail "profile not found: $name"
  features=$(cat "$path")
  validate_features "$features"
  tools_for_features "$features"
  case ",$features," in
    *,lsp,*) unset CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC || true ;;
  esac
  export CLAUDE_KISS_TOOLS="$profile_tools"
  exec claude-kiss "$@"
}

case "${1-}" in
  -h|--help|help)
    usage
    ;;
  --version)
    exec claude-kiss --version
    ;;
  create)
    [ "$#" -ge 2 ] || fail 'usage: claude-kiss-profile create NAME [FEATURE...]'
    shift
    name=$1
    shift
    create_profile "$name" "$@"
    ;;
  launch)
    [ "$#" -ge 2 ] || fail 'usage: claude-kiss-profile launch NAME [Claude arguments...]'
    shift
    name=$1
    shift
    launch_profile "$name" "$@"
    ;;
  list)
    mkdir -p "$profiles_dir"
    printf '%-24s %s\n' PROFILE FEATURES
    found=0
    for path in "$profiles_dir"/*.profile; do
      [ -f "$path" ] || continue
      found=1
      name=${path##*/}
      name=${name%.profile}
      printf '%-24s %s\n' "$name" "$(cat "$path")"
    done
    if [ "$found" -ne 1 ]; then
      printf '%-24s %s\n' '(none)' ''
    fi
    ;;
  show)
    [ "$#" -eq 2 ] || fail 'usage: claude-kiss-profile show NAME'
    show_profile "$2"
    ;;
  rm)
    [ "$#" -eq 2 ] || fail 'usage: claude-kiss-profile rm NAME'
    remove_profile "$2"
    ;;
  *)
    [ "$#" -ge 1 ] || fail 'a profile name or command is required'
    name=$1
    shift
    launch_profile "$name" "$@"
    ;;
esac
